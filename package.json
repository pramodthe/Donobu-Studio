{
  "name": "meetnira",
  "version": "1.0.0",
  "description": "MeetNira Donobu regression with core flows, stability matrix, cookies coverage, and negative paths",
  "scripts": {
    "test": "MEETNIRA_TASK1_DIR=\"$PWD/tasks/Task-1-Risk-Based-Complete-Regression-Suite\" MEETNIRA_REPO_ROOT=\"$PWD\" donobu test --config=tasks/Task-1-Risk-Based-Complete-Regression-Suite/playwright.config.ts",
    "test:task-1": "npm test",
    "test:task-3": "bash tasks/Task-3-Stability-Run-2-After-Code-Changes/run-stability-matrix.sh",
    "test:task-4": "MEETNIRA_TASK4_DIR=\"$PWD/tasks/Task-4-Negative-Path-Matrix\" MEETNIRA_REPO_ROOT=\"$PWD\" donobu test --config=tasks/Task-4-Negative-Path-Matrix/playwright.config.ts",
    "test:headless": "MEETNIRA_HEADLESS=1 MEETNIRA_TASK1_DIR=\"$PWD/tasks/Task-1-Risk-Based-Complete-Regression-Suite\" MEETNIRA_REPO_ROOT=\"$PWD\" donobu test --config=tasks/Task-1-Risk-Based-Complete-Regression-Suite/playwright.config.ts",
    "stability:matrix": "bash tasks/Task-2-Stability-Run-1-Before-Code-Changes/run-stability-5x.sh",
    "stability:matrix:headless": "MEETNIRA_HEADLESS=1 bash tasks/Task-2-Stability-Run-1-Before-Code-Changes/run-stability-5x.sh",
    "stability:5x": "npm run stability:matrix",
    "stability:after": "bash tasks/Task-3-Stability-Run-2-After-Code-Changes/run-stability-matrix.sh",
    "stability:after:headless": "MEETNIRA_HEADLESS=1 bash tasks/Task-3-Stability-Run-2-After-Code-Changes/run-stability-matrix.sh",
    "stability:report": "node tasks/Task-2-Stability-Run-1-Before-Code-Changes/generate-stability-email-report.mjs",
    "report:task-1": "playwright show-report tasks/Task-1-Risk-Based-Complete-Regression-Suite/playwright-report",
    "report:task-2": "playwright show-report tasks/Task-2-Stability-Run-1-Before-Code-Changes/playwright-report",
    "report:task-3": "playwright show-report tasks/Task-3-Stability-Run-2-After-Code-Changes/playwright-report",
    "report:task-4": "playwright show-report tasks/Task-4-Negative-Path-Matrix/playwright-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "donobu": "^5.21.3",
    "dotenv": "^17.4.0"
  }
}
